DATABASE_URL=postgres://postgres:postgres@localhost:54329/commonplace
# First boot creates this admin user. ADMIN_TOKEN doubles as their first API token.
ADMIN_EMAIL=you@example.com
ADMIN_TOKEN=change-me-to-a-long-random-string
# Public base URL, used in notification links and as the OAuth issuer.
PUBLIC_URL=http://localhost:3000
# Optional: OAuth 2.1 for MCP clients. Needs an https PUBLIC_URL, or localhost.
OAUTH_ENABLED=false
# Optional: Slack-compatible incoming webhook that receives every owner ping.
NOTIFY_WEBHOOK_URL=
# Optional: an OpenAI-compatible inference provider for the nightly dream (npm run dream:dev).
# Leave blank and the dream only does housekeeping.
DREAM_LLM_BASE_URL=
DREAM_LLM_MODEL=
DREAM_LLM_API_KEY=
PORT=3000
